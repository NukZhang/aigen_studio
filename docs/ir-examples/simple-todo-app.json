{"projectName": "SimpleTodoApp", "description": "基于 Vue 3 和 Spring Boot 的简单待办事项管理应用", "version": "1.0.0", "techStack": {"frontend": {"framework": "vue3", "version": "3.4.0", "language": "typescript", "languageVersion": "5.3", "buildTool": "vite", "buildToolVersion": "5.0", "uiLibrary": "element-plus", "uiLibraryVersion": "2.4", "stateManagement": "pinia", "stateManagementVersion": "2.1", "router": "vue-router", "routerVersion": "4.2", "httpClient": "axios", "httpClientVersion": "1.6"}, "backend": {"framework": "springboot", "version": "3.2.0", "language": "java", "languageVersion": "17", "buildTool": "maven", "buildToolVersion": "3.8", "dataAccess": "spring-data-jpa", "database": "h2", "databaseVersion": "2.2", "security": "none", "apiDocumentation": "openapi", "apiDocumentationVersion": "3.0", "logging": "slf4j", "testing": "junit5"}}, "architecture": {"frontend": {"structure": {"src/views": "页面组件", "src/components": "可复用组件", "src/api": "API 服务层", "src/router": "路由配置", "src/stores": "状态管理（Pinia）", "src/types": "TypeScript 类型定义", "src/utils": "工具函数", "src/assets": "静态资源"}, "conventions": {"componentNaming": "PascalCase", "fileNaming": "kebab-case", "apiNaming": "camelCase", "typeNaming": "PascalCase", "useCompositionApi": true, "useTypeScript": true}}, "backend": {"structure": {"src/main/java/com/todo/app": {"controller": "REST API 控制器层", "service": "业务逻辑层", "repository": "数据访问层", "entity": "实体类", "dto": "数据传输对象", "config": "配置类"}, "src/main/resources": {"application.yml": "主配置文件"}}, "layering": {"controller": "接收 HTTP 请求，返回响应", "service": "业务逻辑处理", "repository": "数据库操作", "entity": "数据模型", "dto": "数据传输"}, "conventions": {"classNaming": "PascalCase", "methodNaming": "camelCase", "fieldNaming": "camelCase", "constantNaming": "UPPER_SNAKE_CASE", "packageNaming": "lowercase", "useLombok": true, "useJpa": true}}}, "modules": [{"name": "frontend", "type": "vue3", "path": "frontend", "features": ["todo-list", "todo-create", "todo-edit", "todo-delete", "todo-toggle-complete"], "dependencies": {"vue": "^3.4.0", "vue-router": "^4.2.0", "pinia": "^2.1.0", "element-plus": "^2.4.0", "axios": "^1.6.0", "typescript": "^5.3.0", "vite": "^5.0.0"}, "scripts": {"dev": "vite", "build": "vue-tsc && vite build", "preview": "vite preview"}}, {"name": "backend", "type": "springboot", "path": "backend", "features": ["todo-crud", "rest-api", "data-persistence", "api-documentation"], "dependencies": {"spring-boot-starter-web": "3.2.0", "spring-boot-starter-data-jpa": "3.2.0", "springdoc-openapi-starter-webmvc-ui": "2.3.0", "h2": "2.2.224", "lombok": "1.18.30"}, "scripts": {"build": "mvn clean package", "test": "mvn test", "run": "mvn spring-boot:run"}}], "database": {"type": "h2", "location": "file:./data/tododb", "schema": "public", "encoding": "UTF-8", "tables": [{"name": "todos", "description": "待办事项表", "fields": [{"name": "id", "type": "BIGINT", "primaryKey": true, "autoIncrement": true}, {"name": "title", "type": "VARCHAR(255)", "nullable": false}, {"name": "description", "type": "TEXT"}, {"name": "completed", "type": "BOOLEAN", "nullable": false, "defaultValue": "false"}, {"name": "priority", "type": "INT", "defaultValue": "0"}, {"name": "due_date", "type": "TIMESTAMP"}, {"name": "created_at", "type": "TIMESTAMP", "nullable": false, "updatable": false}, {"name": "updated_at", "type": "TIMESTAMP"}]}], "jpaConfig": {"ddlAuto": "update", "showSql": false, "formatSql": false, "dialect": "org.hibernate.dialect.H2Dialect"}}, "deployment": {"ports": {"frontend": 3000, "backend": 8080}, "environmentVariables": {"required": [], "optional": [{"name": "SPRING_PROFILES_ACTIVE", "default": "dev", "description": "Spring 配置文件"}]}, "docker": {"enabled": false, "compose": false}, "nginx": {"enabled": false}}, "conventions": {"api": {"rest": {"baseUrl": "/api", "versioning": "none", "responseFormat": "JSON", "errorHandling": "HTTP status codes"}, "naming": {"endpoints": "kebab-case", "queryParams": "camelCase"}}, "logging": {"level": "INFO", "format": "%d{yyyy-MM-d