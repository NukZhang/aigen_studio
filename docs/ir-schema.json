ullable": {"type": "boolean", "default": true, "description": "是否可为空"}, "unique": {"type": "boolean", "default": false, "description": "是否唯一"}, "foreignKey": {"type": "string", "description": "外键引用"}, "defaultValue": {"type": "string", "description": "默认值"}}}}}}}, "jpaConfig": {"type": "object", "description": "JPA 配置", "properties": {"ddlAuto": {"type": "string", "enum": ["none", "validate", "update", "create", "create-drop"], "description": "DDL 自动模式"}, "showSql": {"type": "boolean", "default": false, "description": "是否显示 SQL"}, "formatSql": {"type": "boolean", "default": false, "description": "是否格式化 SQL"}, "dialect": {"type": "string", "description": "Hibernate 方言"}}}}}, "deployment": {"type": "object", "description": "部署配置", "properties": {"ports": {"type": "object", "description": "端口配置", "properties": {"frontend": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 3000, "description": "前端端口"}, "backend": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 8080, "description": "后端端口"}, "database": {"type": "integer", "minimum": 1, "maximum": 65535, "description": "数据库端口"}}}, "environmentVariables": {"type": "object", "description": "环境变量配置", "properties": {"required": {"type": "array", "description": "必需的环境变量", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "description": "变量名"}, "description": {"type": "string", "description": "变量描述"}, "default": {"type": "string", "description": "默认值"}}}}, "optional": {"type": "array", "description": "可选的环境变量", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "description": "变量名"}, "description": {"type": "string", "description": "变量描述"}, "default": {"type": "string", "description": "默认值"}}}}}}, "docker": {"type": "object", "description": "Docker 配置", "properties": {"enabled": {"type": "boolean", "default": false, "description": "是否启用 Docker"}, "compose": {"type": "boolean", "default": false, "description": "是否使用 Docker Compose"}}}, "nginx": {"type": "object", "description": "Nginx 配置", "properties": {"enabled": {"type": "boolean", "default": false, "description": "是否启用 Nginx"}, "config": {"type": "string", "description": "Nginx 配置文件路径"}}}}}, "conventions": {"type": "object", "description": "项目约定", "properties": {"api": {"type": "object", "description": "API 约定", "properties": {"rest": {"type": "object", "properties": {"baseUrl": {"type": "string", "default": "/api", "description": "API 基础路径"}, "versioning": {"type": "string", "enum": ["none", "url", "header"], "default": "none", "description": "API 版本控制方式"}, "responseFormat": {"type": "string", "enum": ["JSON", "XML"], "default": "JSON", "description": "响应格式"}, "errorHandling": {"type": "string", "description": "错误处理方式"}}}, "naming": {"type": "object", "properties": {"endpoints": {"type": "string", "enum": ["kebab-case", "camelCase", "snake_case"], "default": "kebab-case", "description": "端点命名风格"}, "queryParams": {"type": "string", "enum": ["camelCase", "snake_case", "kebab-case"], "default": "camelCase", "description": "查询参数命名风格"}}}}}, "logging": {"type": "object", "description": "日志约定", "properties": {"level": {"type": "string", "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR"], "default": "INFO", "description": "日志级别"}, "format": {"type": "string", "description": "日志格式"}, "file": {"type": "object", "properties": {"enabled": {"type": "boolean", "default": false, "description": "是否启用文件日志"}, "path": {"type": "string", "description": "日志文件路径"}, "maxSize": {"type": "string", "description": "最大文件大小"}, "maxHistory": {"type": "integer", "description": "最大历史文件数"}}}}}, "security": {"type": "object", "description": "安全约定", "properties": {"cors": {"type": "object", "properties": {"enabled": {"type": "boolean", "default": true, "description": "是否启用 CORS"}, "allowedOrigins": {"type": "array", "items": {"type": "string"}, "description": "允许的源"}, "allowedMethods": {"type": "array", "items": {"type": "string"}, "description": "允许的方法"}, "allowedHeaders": {"type": "array", "items": {"type": "string"}, "description": "允许的请求头"}}}, "authentication": {"type": "object", "properties": {"type": {"type": "string", "enum": ["jwt", "session", "oauth2", "basic", "none"], "description": "认证类型"}, "enabled": {"type": "boolean", "default": false, "description": "是否启用认证"}}}}}, "validation": {"type": "object", "description": "验证约定", "properties": {"inputValidation": {"type": "boolean", "default": true, "description": "是否启用输入验证"}, "outputValidation": {"type": "boolean", "default": false, "description": "是否启用输出验证"}}}}}, "scripts": {"type": "object", "description": "脚本配置", "properties": {"development": {"type": "object", "description": "开发环境脚本", "properties": {"start": {"type": "string", "description": "启动命令"}, "startBackend": {"type": "string", "description": "启动后端命令"}, "startFrontend": {"type": "string", "description": "启动前端命令"}}}, "production": {"type": "object", "description": "生产环境脚本", "properties": {"buildBackend": {"type": "string", "description": "构建后端命令"}, "buildFrontend": {"type": "string", "description": "构建前端命令"}, "startBackend": {"type": "string", "description": "启动生产后端命令"}}}}}}}