{"$schema": "http://json-schema.org/draft-07/schema#", "$id": "https://aigen.studio/schemas/ir/v1.0.0", "title": "AIGen Studio IR Configuration Schema", "description": "IR（Intermediate Representation）配置协议，用于描述 AIGen Studio 代码生成的项目结构、技术栈和功能模块", "type": "object", "required": ["projectName", "version", "techStack", "architecture", "modules"], "properties": {"projectName": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$", "description": "项目名称，以字母开头，只能包含字母、数字和连字符"}, "description": {"type": "string", "maxLength": 500, "description": "项目描述"}, "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "default": "1.0.0", "description": "项目版本号，遵循语义化版本规范"}, "techStack": {"type": "object", "description": "技术栈配置", "required": ["frontend", "backend"], "properties": {"frontend": {"type": "object", "description": "前端技术栈", "required": ["framework", "language", "buildTool"], "properties": {"framework": {"type": "string", "enum": ["vue3", "react", "vue2", "angular"], "description": "前端框架"}, "version": {"type": "string", "description": "框架版本"}, "language": {"type": "string", "enum": ["typescript", "javascript"], "default": "typescript", "description": "编程语言"}, "languageVersion": {"type": "string", "description": "语言版本"}, "buildTool": {"type": "string", "enum": ["vite", "webpack", "rollup", "parcel"], "description": "构建工具"}, "buildToolVersion": {"type": "string", "description": "构建工具版本"}, "uiLibrary": {"type": "string", "enum": ["element-plus", "ant-design", "material-ui", "naive-ui", "none"], "description": "UI 组件库"}, "uiLibraryVersion": {"type": "string", "description": "UI 组件库版本"}, "stateManagement": {"type": "string", "enum": ["pinia", "vuex", "redux", "mobx", "zustand", "none"], "description": "状态管理库"}, "stateManagementVersion": {"type": "string", "description": "状态管理库版本"}, "router": {"type": "string", "enum": ["vue-router", "react-router", "angular-router", "none"], "description": "路由库"}, "routerVersion": {"type": "string", "description": "路由库版本"}, "httpClient": {"type": "string", "enum": ["axios", "fetch", "ky", "none"], "default": "axios", "description": "HTTP 客户端"}, "httpClientVersion": {"type": "string", "description": "HTTP 客户端版本"}, "codeEditor": {"type": "string", "enum": ["monaco-editor", "codemirror", "ace", "none"], "description": "代码编辑器"}, "codeEditorVersion": {"type": "string", "description": "代码编辑器版本"}, "markdown": {"type": "string", "enum": ["marked", "markdown-it", "remark", "none"], "description": "Markdown 解析器"}, "markdownVersion": {"type": "string", "description": "Markdown 解析器版本"}}}, "backend": {"type": "object", "description": "后端技术栈", "required": ["framework", "language", "buildTool"], "properties": {"framework": {"type": "string", "enum": ["springboot", "nodejs", "express", "fastify", "nest", "django", "flask"], "description": "后端框架"}, "version": {"type": "string", "description": "框架版本"}, "language": {"type": "string", "enum": ["java", "typescript", "javascript", "python", "go"], "description": "编程语言"}, "languageVersion": {"type": "string", "description": "语言版本"}, "buildTool": {"type": "string", "enum": ["maven", "gradle", "npm", "pnpm", "yarn", "pip", "poetry"], "description": "构建工具"}, "buildToolVersion": {"type": "string", "description": "构建工具版本"}, "dataAccess": {"type": "string", "enum": ["spring-data-jpa", "mybatis-plus", "typeorm", "sequelize", "mongoose", "sqlalchemy"], "description": "数据访问层"}, "database": {"type": "string", "enum": ["h2", "mysql", "postgresql", "mongodb", "sqlite", "oracle"], "description": "数据库类型"}, "databaseVersion": {"type": "string", "description": "数据库版本"}, "security": {"type": "string", "enum": ["spring-security", "passport", "jwt", "auth0", "none"], "description": "安全框架"}, "apiDocumentation": {"type": "string", "enum": ["openapi", "swagger", "graphql", "none"], "description": "API 文档工具"}, "apiDocumentationVersion": {"type": "string", "description": "API 文档工具版本"}, "logging": {"type": "string", "enum": ["slf4j", "log4j", "winston", "bunyan", "pino", "none"], "description": "日志框架"}, "testing": {"type": "string", "enum": ["junit5", "jest", "mocha", "pytest", "none"], "description": "测试框架"}}}}}, "architecture": {"type": "object", "description": "架构配置", "required": ["frontend", "backend"], "properties": {"frontend": {"type": "object", "description": "前端架构", "required": ["structure"], "properties": {"structure": {"type": "object", "description": "目录结构定义", "additionalProperties": {"type": "string"}}, "conventions": {"type": "object", "description": "编码约定", "properties": {"componentNaming": {"type": "string", "enum": ["PascalCase", "kebab-case", "camelCase"]}, "fileNaming": {"type": "string", "enum": ["PascalCase", "kebab-case", "camelCase"]}, "apiNaming": {"type": "string", "enum": ["camelCase", "snake_case", "PascalCase"]}, "typeNaming": {"type": "string", "enum": ["PascalCase", "kebab-case"]}, "useCompositionApi": {"type": "boolean", "default": true}, "useTypeScript": {"type": "boolean", "default": true}}}}}, "backend": {"type": "object", "description": "后端架构", "required": ["structure", "layering"], "properties": {"structure": {"type": "object", "description": "目录结构定义", "additionalProperties": {"type": "string"}}, "layering": {"type": "object", "description": "分层架构定义", "properties": {"controller": {"type": "string", "description": "Controller 层职责"}, "service": {"type": "string", "description": "Service 层职责"}, "repository": {"type": "string", "description": "Repository 层职责"}, "entity": {"type": "string", "description": "Entity 层职责"}, "dto": {"type": "string", "description": "DTO 层职责"}}}, "conventions": {"type": "object", "description": "编码约定", "properties": {"classNaming": {"type": "string", "enum": ["PascalCase", "camelCase"]}, "methodNaming": {"type": "string", "enum": ["camelCase", "snake_case"]}, "fieldNaming": {"type": "string", "enum": ["camelCase", "snake_case"]}, "constantNaming": {"type": "string", "enum": ["UPPER_SNAKE_CASE", "camelCase"]}, "packageNaming": {"type": "string", "enum": ["lowercase", "ca